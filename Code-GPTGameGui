# ------------------------------ EVENT LOOP ----------------------------------

running = True
while running:
    now = pygame.time.get_ticks()
    width, height = screen.get_size()
    left_w = width // 2
    right_x = left_w

    for e in pygame.event.get():
        if e.type == pygame.QUIT:
            running = False

        elif e.type == pygame.VIDEORESIZE:
            new_w = max(MIN_WIDTH, e.w)
            new_h = max(MIN_HEIGHT, e.h)
            screen = pygame.display.set_mode((new_w, new_h), pygame.RESIZABLE)

        elif e.type == pygame.KEYDOWN:
            if e.key == pygame.K_ESCAPE:
                running = False
            elif e.key == pygame.K_RETURN and screen_mode == "allocation":
                show_event_overlay = False
                advance_year()

        elif e.type == pygame.MOUSEBUTTONDOWN and e.button == 1:
            pos = e.pos
            if show_event_overlay and screen_mode != "final":
                show_event_overlay = False
                continue

            clicked_slider = False
            if screen_mode == "allocation":
                for key, rect in slider_rects.items():
                    if rect.collidepoint(pos) and active_tab == "TRADING DESK":
                        if keep_allocation:
                            set_toast("Turn off 'keep allocation' to edit your sliders.")
                        else:
                            dragging = key
                            handle_slider(key, pos[0])
                        clicked_slider = True
                        break
                if clicked_slider:
                    continue

            clicked_button = next((key for key, rect in buttons.items() if rect.collidepoint(pos)), None)
            if clicked_button:
                if clicked_button.startswith("tab_"):
                    active_tab = clicked_button[4:]
                elif clicked_button == "advance":
                    show_event_overlay = False
                    advance_year()
                elif clicked_button == "keep":
                    keep_allocation = not keep_allocation
                    set_toast("Previous allocation will be kept." if keep_allocation else "Allocation editing enabled.")
                elif clicked_button == "next_year":
                    if year >= YEARS:
                        screen_mode = "final"
                    else:
                        year += 1
                        if not keep_allocation:
                            # Keep current values as defaults; the player may edit them.
                            pass
                        begin_next_year()
                        screen_mode = "allocation"
                        active_tab = "TRADING DESK"
                elif clicked_button == "results_competitors":
                    active_tab = "COMPETITORS"
                    screen_mode = "allocation"
                elif clicked_button == "restart":
                    restart_game()

        elif e.type == pygame.MOUSEBUTTONUP and e.button == 1:
            dragging = None

        elif e.type == pygame.MOUSEMOTION and dragging and screen_mode == "allocation" and active_tab == "TRADING DESK":
            if dragging in slider_rects and not keep_allocation:
                handle_slider(dragging, e.pos[0])

    # Keep minimum allocation values in bounds and cash residual live.
    allocation["Cash"] = max(0, 100-sum(allocation[k] for k in ("Stocks", "Bonds", "Gold", "Real estate")))

    draw(now)
    pygame.display.flip()
    clock.tick(60)

pygame.quit()
