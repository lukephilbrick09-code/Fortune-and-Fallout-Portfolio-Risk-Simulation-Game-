def set_toast(message, duration=3000):
    global toast, toast_until
    toast = message
    toast_until = pygame.time.get_ticks() + duration

def rebalance_stock_split(changed_key, new_value):
    # Keep all three stock percentages summing to exactly 100.
    other_keys = [key for key in ("BHRD", "BPOP", "MDTA") if key != changed_key]
    remaining = 100 - new_value
    old_total = sum(stock_split[k] for k in other_keys)
    if old_total <= 0:
        stock_split[other_keys[0]] = remaining
        stock_split[other_keys[1]] = 0
    else:
        first = round(remaining * stock_split[other_keys[0]] / old_total)
        first = max(0, min(remaining, first))
        stock_split[other_keys[0]] = first
        stock_split[other_keys[1]] = remaining-first
    stock_split[changed_key] = new_value

def handle_slider(key, mouse_x):
    if key.startswith("alloc_"):
        asset = key[6:]
        other_assets = [a for a in ("Stocks", "Bonds", "Gold", "Real estate") if a != asset]
        rect = slider_rects[key]
        new_value = round(max(0, min(100, (mouse_x-rect.x-7) / max(1, rect.width-14) * 100)))
        available = 100 - sum(allocation[a] for a in other_assets)
        new_value = max(0, min(new_value, available))
        allocation[asset] = new_value
        allocation["Cash"] = 100 - sum(allocation[a] for a in ("Stocks", "Bonds", "Gold", "Real estate"))
    elif key.startswith("stock_"):
        ticker = key[6:]
        rect = slider_rects[key]
        new_value = round(max(0, min(100, (mouse_x-rect.x-7) / max(1, rect.width-14) * 100)))
        rebalance_stock_split(ticker, new_value)

def begin_next_year():
    global event, means, actual, year_started, show_event_overlay, event_overlay_started
    event, means, actual = make_year_market()
    year_started = MyPortfolio
    show_event_overlay = True
    event_overlay_started = pygame.time.get_ticks()

def advance_year():
    global MyPortfolio, annual_gain, annual_return, total_gain, screen_mode
    global GuardianPortfolio, StrategistPortfolio, MaverickPortfolio, last_result_breakdown
    global year, keep_allocation

    if sum(allocation[k] for k in ("Stocks", "Bonds", "Gold", "Real estate")) > 100:
        set_toast("Allocation exceeds 100%. Adjust your sliders.")
        return

    # The player's stock split remains 100% of the stock allocation.
    result = calculate_portfolio(MyPortfolio, allocation, stock_split, actual)
    last_result_breakdown = result
    old_value = MyPortfolio
    MyPortfolio = result["Total"]
    annual_gain = MyPortfolio-old_value
    annual_return = (annual_gain/old_value)*100 if old_value else 0
    total_gain = MyPortfolio-StartingPortfolio

    # Competitors compound their portfolios with the same annual asset returns.
    for rival in competitors:
        rival["value"] = calculate_competitor(rival["value"], rival["allocation"], actual)
    GuardianPortfolio = competitors[0]["value"]
    StrategistPortfolio = competitors[1]["value"]
    MaverickPortfolio = competitors[2]["value"]

    yearly_summary.append([year, event, old_value, annual_gain, annual_return, MyPortfolio])
    screen_mode = "results"
    keep_allocation = False
    set_toast(f"Year {year} complete. Results are ready.", 3500)

