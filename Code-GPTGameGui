    global StartingPortfolio, MyPortfolio, GuardianPortfolio, StrategistPortfolio, MaverickPortfolio
    global competitors, allocation, stock_split, year, event, means, actual, year_started
    global annual_gain, annual_return, total_gain, yearly_summary, active_tab, screen_mode
    global keep_allocation, show_event_overlay, event_overlay_started, last_result_breakdown
    StartingPortfolio = random.randint(80000, 120000)
