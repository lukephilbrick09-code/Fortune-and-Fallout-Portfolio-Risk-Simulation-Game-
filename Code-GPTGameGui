# ------------------------------ VERSION 5 GAME LOGIC ------------------------

def generate_return(mean, volatility):
    return max(-0.95, random.gauss(mean, volatility))

def adjust_expected_return(mean, adjustment):
    return mean + random.uniform(-adjustment, adjustment)

def get_event_means(event):
    if event == "Bull market":
        return {
            "BHRD": 0.16, "BPOP": 0.09, "MDTA": 0.24, "Stocks overall": 0.16,
            "Bonds": 0.04, "Gold": 0.03, "Cash": 0.02, "Real estate": 0.09,
            "description": "Stocks and property may benefit while gold may struggle.",
            "warning": "BULL MARKET",
        }
    if event == "Market crash":
        return {
            "BHRD": -0.17, "BPOP": -0.10, "MDTA": -0.23, "Stocks overall": -0.17,
            "Bonds": 0.02, "Gold": 0.13, "Cash": 0.03, "Real estate": -0.12,
            "description": "Markets are falling sharply. Gold, bonds and cash may offer protection.",
            "warning": "MARKET CRASH",
        }
    if event == "High inflation":
        return {
            "BHRD": -0.03, "BPOP": -0.02, "MDTA": -0.08, "Stocks overall": -0.03,
            "Bonds": -0.06, "Gold": 0.17, "Cash": -0.02, "Real estate": 0.08,
            "description": "Prices are rising quickly. Gold and property may perform better.",
            "warning": "HIGH INFLATION",
        }
    if event == "Gold rally":
        return {
            "BHRD": 0.06, "BPOP": 0.05, "MDTA": 0.07, "Stocks overall": 0.06,
            "Bonds": 0.04, "Gold": 0.20, "Cash": 0.02, "Real estate": 0.06,
            "description": "Gold is rising in value. Other assets receive no special boost.",
            "warning": "GOLD RALLY",
        }
    return {
        "BHRD": 0.08, "BPOP": 0.05, "MDTA": 0.12, "Stocks overall": 0.08,
        "Bonds": 0.04, "Gold": 0.05, "Cash": 0.02, "Real estate": 0.06,
        "description": "No major event. Random gains and losses can still occur.",
        "warning": "NO MAJOR EVENT",
    }

def make_year_market():
    event = random.choices(MarketEvents, weights=EVENT_WEIGHTS, k=1)[0]
    means = get_event_means(event)
    adjustments = {
        "BHRD": 0.03, "BPOP": 0.02, "MDTA": 0.05, "Stocks overall": 0.03,
        "Bonds": 0.01, "Gold": 0.03, "Cash": 0.005, "Real estate": 0.02,
    }
    for asset, amount in adjustments.items():
        means[asset] = adjust_expected_return(means[asset], amount)

    volatilities = {
        "BHRD": 0.22, "BPOP": 0.12, "MDTA": 0.35, "Stocks overall": 0.22,
        "Bonds": 0.06, "Gold": 0.15, "Cash": 0.015, "Real estate": 0.12,
    }
    actual = {asset: generate_return(means[asset], volatilities[asset]) for asset in volatilities}
    return event, means, actual

def calculate_portfolio(value, allocation, stock_split, actual):
    stock_value = value * allocation["Stocks"] / 100
    result = {
        "BHRD": stock_value * stock_split["BHRD"] / 100 * (1 + actual["BHRD"]),
        "BPOP": stock_value * stock_split["BPOP"] / 100 * (1 + actual["BPOP"]),
        "MDTA": stock_value * stock_split["MDTA"] / 100 * (1 + actual["MDTA"]),
        "Bonds": value * allocation["Bonds"] / 100 * (1 + actual["Bonds"]),
        "Gold": value * allocation["Gold"] / 100 * (1 + actual["Gold"]),
        "Cash": value * allocation["Cash"] / 100 * (1 + actual["Cash"]),
        "Real estate": value * allocation["Real estate"] / 100 * (1 + actual["Real estate"]),
    }
    result["Stocks"] = result["BHRD"] + result["BPOP"] + result["MDTA"]
    result["Total"] = sum(result[k] for k in ("Stocks", "Bonds", "Gold", "Cash", "Real estate"))
    return result

def calculate_competitor(value, allocation, actual):
    # Competitors use the same annual market returns as in Version 5.
    return value * sum(
        allocation[asset] / 100 * (1 + actual[return_key])
        for asset, return_key in [
            ("Stocks", "Stocks overall"), ("Bonds", "Bonds"), ("Gold", "Gold"),
            ("Cash", "Cash"), ("Real estate", "Real estate")
        ]
    )

