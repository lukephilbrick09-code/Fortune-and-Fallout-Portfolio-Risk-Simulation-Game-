        # Monitor tickers / chart lines
        draw_text(scene, ["MKT / LIVE", "F&F TERMINAL", "ASSET MIX"][idx],
                  mx+9, my+7, tint, FONT_TINY)
        for line in range(3):
            text = f"{['BHRD','BPOP','MDTA'][line]} {random.Random(line+idx).randint(10,99)}.{(now//500+line*7)%10}"
            draw_text(scene, text, mx+8, my+23+line*14, PALE_GREEN if line != 1 else tint, FONT_TINY)
        chart_y = my + int(mh*.73)
        points = []
        for p in range(9):
            px = mx + 7 + p * (mw-14) / 8
            py = chart_y + math.sin((p + now/550 + idx) * 1.3) * 8 + math.cos(p*0.7+idx)*4
