def draw_text(surface, text, x, y, colour=WHITE, font=FONT, anchor="topleft"):
    image = font.render(str(text), True, colour)
    rect = image.get_rect()
    setattr(rect, anchor, (int(x), int(y)))
    surface.blit(image, rect)
    return rect

def money(value):
    return f"£{value:,.2f}"

def pct(value):
    return f"{value:+.2f}%"

def panel(surface, rect, fill=PANEL, outline=BORDER, radius=8, width=1):
    pygame.draw.rect(surface, fill, rect, border_radius=radius)
    pygame.draw.rect(surface, outline, rect, width, border_radius=radius)

def button(surface, key, rect, label, enabled=True, primary=False):
    buttons[key] = pygame.Rect(rect)
    fill = (56, 37, 20) if primary and enabled else (22, 31, 35)
    outline = ORANGE if primary and enabled else BORDER
    colour = AMBER if primary and enabled else (WHITE if enabled else MUTED)
    pygame.draw.rect(surface, fill, rect, border_radius=5)
    pygame.draw.rect(surface, outline, rect, 2 if primary else 1, border_radius=5)
    draw_text(surface, label, rect[0] + rect[2] / 2, rect[1] + rect[3] / 2,
              colour, FONT, "center")

def draw_slider(surface, key, label, value, x, y, width, colour=ORANGE, suffix="%"):
    draw_text(surface, label.upper(), x, y, MUTED, FONT_SMALL)
    draw_text(surface, f"{int(round(value))}{suffix}", x + width, y, colour, FONT, "topright")
    track = pygame.Rect(x, y + 24, width, 7)
    pygame.draw.rect(surface, (43, 55, 59), track, border_radius=4)
    fill_width = max(0, min(width, int(width * value / 100)))
    if fill_width:
        pygame.draw.rect(surface, colour, (track.x, track.y, fill_width, track.height), border_radius=4)
    knob_x = track.x + fill_width
    pygame.draw.circle(surface, BLACK, (knob_x, track.centery), 9)
    pygame.draw.circle(surface, colour, (knob_x, track.centery), 6)
    slider_rects[key] = pygame.Rect(track.x - 7, track.y - 12, track.width + 14, 31)

def wrap_text(text, max_width, font):
    words = text.split()
    lines, line = [], ""
    for word in words:
        trial = word if not line else line + " " + word
        if font.size(trial)[0] <= max_width:
            line = trial
        else:
            if line:
                lines.append(line)
            line = word
    if line:
        lines.append(line)
    return lines

def draw_wrapped(surface, text, x, y, width, colour=MUTED, font=FONT_SMALL, line_gap=4):
    for line in wrap_text(text, width, font):
        draw_text(surface, line, x, y, colour, font)
        y += font.get_height() + line_gap
    return y

