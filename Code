      pass


def generate_return(mean, volatility):
    return max(-0.95, random.gauss(mean, volatility))


StartingPortfolio = 100000
Portfolio = StartingPortfolio
years = 10
game = str("GO")
BondPie = -1
GoldPie = -1
CashPie = -1
StockPie = -1
RealEstatePie = -1

# Store portfolio values for the yearly summary
YearlySummary = []

for x in range(years):
    print(f"\n===== Year {x + 1} of {years} =====")
    PreviousPortfolio = Portfolio
    print(f"Portfolio at start of year: £{Portfolio:,.2f}")

    if game == "GO":

        # Market event
        MarketEvent = random.choices(MarketEvents, weights=(15, 5, 10, 20, 50), k=1)

        print(" Market Event Occurring: " + MarketEvent[0])

        # Set expected average returns and display event warnings
        if MarketEvent[0] == "Bull market":
            print("WARNING: Bull Market!")
            print("Description: Stock markets are performing well. Stocks and property may benefit, while gold may struggle.")

            BHRDMean = 0.16
            BPOPMean = 0.09
            MDTAMean = 0.24
            StockMean = 0.16
            BondMean = 0.04
            GoldMean = 0.03
            CashMean = 0.02
            RealEstateMean = 0.09

        elif MarketEvent[0] == "Market crash":
            print("WARNING: MARKET CRASH!")
            print("Description: Markets are falling sharply. Stocks and property are likely to suffer, while gold, bonds and cash may provide some protection.")

            BHRDMean = -0.17
            BPOPMean = -0.10
            MDTAMean = -0.23
            StockMean = -0.17
            BondMean = 0.02
            GoldMean = 0.13
            CashMean = 0.03
            RealEstateMean = -0.12

        elif MarketEvent[0] == "High inflation":
            print("WARNING: HIGH INFLATION!")
            print("Description: Prices are rising quickly. Bonds and cash may lose purchasing power, while gold and property may perform better.")

            BHRDMean = -0.03
            BPOPMean = -0.02
            MDTAMean = -0.08
            StockMean = -0.03
            BondMean = -0.06
            GoldMean = 0.17
            CashMean = -0.02
            RealEstateMean = 0.08

        elif MarketEvent[0] == "Gold rally":
            print("WARNING: GOLD RALLY!")
            print("Description: Gold is rising in value. Gold investments may benefit, while other assets receive no special boost.")

            BHRDMean = 0.06
            BPOPMean = 0.05
            MDTAMean = 0.07
            StockMean = 0.06
            BondMean = 0.04
            GoldMean = 0.20
            CashMean = 0.02
            RealEstateMean = 0.06

        elif MarketEvent[0] == "No event":
            print("No major market event this year.")
            print("Description: Markets follow their normal expected return assumptions, but random gains and losses can still occur.")

            BHRDMean = 0.08
            BPOPMean = 0.05
            MDTAMean = 0.12
            StockMean = 0.08
            BondMean = 0.04
            GoldMean = 0.05
            CashMean = 0.02
            RealEstateMean = 0.06

        # Display expected average returns for this market event
        print("\n--- Expected Average Annual Returns ---")
        print(f"BHRD: {BHRDMean * 100:.2f}%")
        print(f"BPOP: {BPOPMean * 100:.2f}%")
        print(f"MDTA: {MDTAMean * 100:.2f}%")
        print(f"Stocks overall: {StockMean * 100:.2f}%")
        print(f"Bonds: {BondMean * 100:.2f}%")
        print(f"Gold: {GoldMean * 100:.2f}%")
        print(f"Cash: {CashMean * 100:.2f}%")
        print(f"Real estate: {RealEstateMean * 100:.2f}%")
        print("These are illustrative averages, not guaranteed returns.")
        print("Actual returns will vary due to random market movements.")

        # Generate random returns around the expected averages
        BHRDReturn = generate_return(BHRDMean, 0.22)
        BPOPReturn = generate_return(BPOPMean, 0.12)
        MDTAReturn = generate_return(MDTAMean, 0.35)

        StockReturn = generate_return(StockMean, 0.22)
        BondReturn = generate_return(BondMean, 0.06)
        GoldReturn = generate_return(GoldMean, 0.15)
        CashReturn = generate_return(CashMean, 0.015)
        RealEstateReturn = generate_return(RealEstateMean, 0.12)

    # Same allocation feature
    if x > 0:
        while True:
            KeepAllocation = input(
                "\nDo you want to keep the same allocation as last year? (yes/no): "
            ).strip().lower()

            if KeepAllocation in ["yes", "no"]:
                break
            else:
                print("Please enter yes or no.")

    else:
        KeepAllocation = "no"

    if KeepAllocation == "no":

        # Choose overall portfolio allocation
        while True:
            StockPie = portfolio_percentage("stocks")
            BondPie = portfolio_percentage("bonds")
            GoldPie = portfolio_percentage("gold")
            RealEstatePie = portfolio_percentage("real estate")

            if StockPie + BondPie + GoldPie + RealEstatePie <= 100:
                CashPie = 100 - StockPie - BondPie - GoldPie - RealEstatePie
                break
            else:
                print("You cannot invest more than 100%! Try again.")

        # Choose individual stock allocation
        if StockPie > 0:
            print("The stocks available are:")
            print("Bighard, BHRD - a large established tech company which holds medium risk and medium reward\nBubblyPop, BPOP - another established popular consumer stock that is in a slowly growing market, yielding less risk and reward.\nMudita, MDTA-  an AI and semiconductor growth stock. Highly established in a rapidly growing market. Very high reward, very high risk.")

            while True:
                BHRDPie = stock_percentage("BHRD")
                BPOPPie = stock_percentage("BPOP")
                MDTAPie = stock_percentage("MDTA")

                if BHRDPie + BPOPPie + MDTAPie == 100:
                    break
                else:
                    print("Your stock allocations must add up to exactly 100%. Try again.")

        else:
            BHRDPie = 0
            BPOPPie = 0
            MDTAPie = 0

    else:
        print("\nKeeping last year's portfolio allocation.")
        print(f"Stocks: {StockPie}%")
        print(f"Bonds: {BondPie}%")
        print(f"Gold: {GoldPie}%")
        print(f"Real estate: {RealEstatePie}%")
        print(f"Cash: {CashPie}%")

        if StockPie > 0:
            print(f"  BHRD: {BHRDPie}% of stocks")
            print(f"  BPOP: {BPOPPie}% of stocks")
            print(f"  MDTA: {MDTAPie}% of stocks")

    TotalPie = StockPie + BondPie + GoldPie + CashPie + RealEstatePie

    # Calculate individual stock values
    BHRDCapitalGL = (Portfolio * (StockPie / 100) * (BHRDPie / 100)) * (1 + BHRDReturn)
    BPOPCapitalGL = (Portfolio * (StockPie / 100) * (BPOPPie / 100)) * (1 + BPOPReturn)
    MDTACapitalGL = (Portfolio * (StockPie / 100) * (MDTAPie / 100)) * (1 + MDTAReturn)

    # Calculate total stock value
    StockCapitalGL = BHRDCapitalGL + BPOPCapitalGL + MDTACapitalGL

    # Calculate other asset values
    BondCapitalGL = (Portfolio * (BondPie / 100)) * (1 + BondReturn)
    GoldCapitalGL = (Portfolio * (GoldPie / 100)) * (1 + GoldReturn)
    CashCapitalGL = (Portfolio * (CashPie / 100)) * (1 + CashReturn)
    RealEstateCapitalGL = (Portfolio * (RealEstatePie / 100)) * (1 + RealEstateReturn)

    # Print individual assets
    print(f"\nYour BHRD stocks are now worth £{BHRDCapitalGL:,.2f}")
    print(f"Your BPOP stocks are now worth £{BPOPCapitalGL:,.2f}")
    print(f"Your MDTA stocks are now worth £{MDTACapitalGL:,.2f}")
    print(f"Your total stocks are now worth £{StockCapitalGL:,.2f}")
    print(f"Your bonds are now worth £{BondCapitalGL:,.2f}")
    print(f"Your gold is now worth £{GoldCapitalGL:,.2f}")
    print(f"Your cash is now worth £{CashCapitalGL:,.2f}")
    print(f"Your real estate is now worth £{RealEstateCapitalGL:,.2f}")

    # Print total portfolio value
    Portfolio = sum([StockCapitalGL, BondCapitalGL, GoldCapitalGL, CashCapitalGL, RealEstateCapitalGL])
    print(f"Your total portfolio is now worth £{Portfolio:,.2f}")

    # Calculate total portfolio gains
    totalgain = Portfolio - StartingPortfolio
    AnnualGain = Portfolio - PreviousPortfolio
    AnnualReturn = (AnnualGain / PreviousPortfolio) * 100

    print(f"Your total gains have been £{totalgain:,.2f}")
    print(f"Your annual gain/loss is £{AnnualGain:,.2f}")
    print(f"Your annual return is {AnnualReturn:.2f}%")

    # Store yearly results for the summary
    YearlySummary.append([
        x + 1,
        MarketEvent[0],
        PreviousPortfolio,
        AnnualGain,
        AnnualReturn,
        Portfolio
    ])

# Final results
print("\nGAME OVER")
print(f"Starting portfolio: £{StartingPortfolio:,.2f}")
print(f"Final portfolio: £{Portfolio:,.2f}")
print(f"Total gains/losses: £{Portfolio - StartingPortfolio:,.2f}")
print(f"Total return: {((Portfolio / StartingPortfolio) - 1) * 100:.2f}%")

# Yearly summary table
print("\n================ YEARLY SUMMARY ================")
print(f"{'Year':<8}{'Market Event':<20}{'Start Value':>16}{'Gain/Loss':>16}{'Return':>12}{'End Value':>16}")
print("-" * 88)

for row in YearlySummary:
    print(f"{row[0]:<8}{row[1]:<20}£{row[2]:>14,.2f}£{row[3]:>14,.2f}{row[4]:>11.2f}%£{row[5]:>14,.2f}")

