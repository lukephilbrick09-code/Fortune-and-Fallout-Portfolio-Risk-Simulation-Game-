import random

MarketEvents = ["Bull market", "Market crash", "High inflation", "Gold rally", "No event"]

def stock_percentage(stock):
    while True:
        playerinput = input(f"What percentage of your stock portfolio do you want to put into {stock}? ").strip()

        if playerinput.isdigit():
            value = int(playerinput)

            if 0 <= value <= 100:
                return value
            else:
                print("Enter a percentage between 0 and 100!")
        else:
            print("Please enter a valid whole number! Try again.")


