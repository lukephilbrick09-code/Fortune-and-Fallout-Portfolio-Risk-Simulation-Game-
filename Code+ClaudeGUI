def text(s, txt, font, col, pos, anchor="topleft"):
    img = font.render(str(txt), True, col); r = img.get_rect(**{anchor: pos}); s.blit(img, r); return r
def wrap(s, font, width):
    lines, cur = [], ""
    for w in s.split():
        t = (cur + " " + w).strip()
        if font.size(t)[0] <= width: cur = t
        else: lines.append(cur); cur = w
    return lines + ([cur] if cur else [])
def box(r, title=None):
