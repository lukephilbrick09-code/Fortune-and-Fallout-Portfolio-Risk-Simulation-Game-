def draw_popup():
    e = EV[g.event]; k = min(1, (now() - g.phase_t) / 0.35); ease = 1 - (1 - k) ** 3
    dim = pygame.Surface((W, H), pygame.SRCALPHA); dim.fill((0, 0, 0, 175)); screen.blit(dim, (0, 0))
    if g.event == "Market crash" and k < 1:
        fl = pygame.Surface((W, H), pygame.SRCALPHA); fl.fill((255, 0, 0, int(120 * (1 - k)))); screen.blit(fl, (0, 0))
    r = pygame.Rect(0, 0, int(800 * ease), int(360 * ease)); r.center = (W // 2, H // 2)
    pygame.draw.rect(screen, (8, 8, 12), r)
    pulse = 0.65 + 0.35 * math.sin(now() * 8); bc = tuple(int(c * pulse) for c in e["col"])
    pygame.draw.rect(screen, bc, r, 5); pygame.draw.rect(screen, e["col"], r.inflate(-16, -16), 1)
    if k >= 1:
        text(screen, e["warn"], f_l, e["col"], (W // 2, r.y + 34), "center")
        text(screen, e["title"], f_pop, e["col"], (W // 2, r.y + 100), "center")
        for i, ln in enumerate(wrap(e["desc"], f_m, 700)): text(screen, ln, f_m, PGREEN, (W // 2, r.y + 170 + i * 26), "center")
        new = " (NEW PHASE)" if g.phase_changed else ""
        text(screen, f"MARKET TREND: {g.phase_name.upper()}{new}", f_mb, PH_COL[g.phase_name], (W // 2, r.y + 276), "center")
        if int(now() * 2) % 2: text(screen, "PRESS ENTER / CLICK TO CONTINUE", f_s, AMBER, (W // 2, r.bottom - 30), "center")

