# ------------------------------------------------------------------ main loop
def action():
    global tab
    if g.phase == "event": g.phase = "allocate"
    elif g.phase == "allocate": g.confirm()
    elif g.phase == "result": g.advance()
    elif g.phase == "final": g.reset(); tab = 0

def main():
    global tab, chart_sel
    drag = None
    while True:
        dt = clock.tick(60) / 1000; t = now()
        for ev in pygame.event.get():
            if ev.type == pygame.QUIT: pygame.quit(); sys.exit()
            elif ev.type == pygame.KEYDOWN:
                if ev.key == pygame.K_ESCAPE: pygame.quit(); sys.exit()
                elif ev.key == pygame.K_F11: pygame.display.toggle_fullscreen()
                elif ev.key in (pygame.K_RETURN, pygame.K_KP_ENTER): action()
                elif g.phase != "event":
                    if ev.key in (pygame.K_1, pygame.K_2, pygame.K_3, pygame.K_4): tab = ev.key - pygame.K_1
                    elif tab == 3 and ev.key in (pygame.K_a, pygame.K_b, pygame.K_c, pygame.K_d): chart_sel = ev.key - pygame.K_a
            elif ev.type == pygame.MOUSEBUTTONDOWN and ev.button == 1:
                p = ev.pos
                if g.phase == "event": action(); continue
                for i, r in enumerate(TAB_R):
                    if r.collidepoint(p): tab = i
                if tab == 3:
                    for i, r in enumerate(CH_R):
                        if r.collidepoint(p): chart_sel = i
                    continue
                if tab != 0: continue
                if g.phase == "final":
                    if BTN_MAIN.collidepoint(p): action()
                    continue
                if g.phase == "result":
                    if BTN_MAIN.collidepoint(p): g.advance()
                    continue
                if BTN_MAIN.collidepoint(p): g.confirm()
                elif g.last and BTN_KEEP.collidepoint(p): g.confirm(keep=True)
                for i, r in enumerate(AL_R):
                    if r.inflate(0, 6).collidepoint(p): drag = ("a", i); set_alloc(AL[i][0], sval(r, p[0]))
                if g.alloc["stock"] > 0:
                    for i, r in enumerate(SUB_R):
                        if r.collidepoint(p): drag = ("s", i); set_sub(i, sval(r, p[0]))
            elif ev.type == pygame.MOUSEBUTTONUP: drag = None
            elif ev.type == pygame.MOUSEMOTION and drag and g.phase == "allocate" and tab == 0:
                if drag[0] == "a": set_alloc(AL[drag[1]][0], sval(AL_R[drag[1]], ev.pos[0]))
                else: set_sub(drag[1], sval(SUB_R[drag[1]], ev.pos[0]))
        draw_scene(t, dt); draw_right()
        if g.phase == "event": draw_popup()
        pygame.display.flip()

if __name__ == "__main__":
    main()
