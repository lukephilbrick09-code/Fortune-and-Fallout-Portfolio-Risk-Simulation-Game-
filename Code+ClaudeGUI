def sentiment():
    """0-4 sentiment level from trend, last market return and drawdown."""
    last = g.last_rets[3] if g.last_rets else 0.0
    score = max(0.0, min(1.0, SENT_BASE[g.phase_name] + last * 0.8 - g.drawdown * 0.6))
    return min(4, int(score * 5))

# NEW (Upgrade 6): plain-English insights built from live data
def make_insights():
    out = []; dd = g.drawdown * 100
    if g.dip and g.recovering: out.append(f"The market is {dd:.0f}% below its recent peak but rose last year. Recovery remains uncertain and losses could return.")
    elif g.dip: out.append(f"The market is {dd:.0f}% below its recent peak. Further losses remain possible, so a dip is not a guaranteed opportunity.")
    elif g.recovering: out.append(f"The market has entered a recovery phase, but prices remain {dd:.0f}% below their previous high.")
    elif g.phase_name == "Bull Market" and g.phase_age >= CFG["OVEREXTEND_YEARS"]:
        out.append(f"The bull run is {g.phase_age} years old. Long gains can leave markets overextended, which raises (but does not guarantee) correction risk.")
    elif dd >= 1: out.append(f"The market is {dd:.0f}% below its recent peak.")
    else: out.append("The market is at or near its recent peak.")
    out.append(f"Current market trend: {g.phase_name}. Trends often last several years but can change without warning.")
    if g.last_rets:
        best = max(range(3), key=lambda i: g.last_rets[i]); others = [VOL[i] for i in range(3) if i != best]
        cmp_ = "remains higher" if VOL[best] > sum(others) / 2 else "is lower"
        out.append(f"{STOCKS[best]} outperformed the other stocks last year ({g.last_rets[best] * 100:+.1f}%), but its volatility {cmp_} ({VOL[best] * 100:.0f}%).")
    if g.event != "No event": out.append(f"This year's event ({EV[g.event]['title'].lower()}) acts on top of the {g.phase_name.lower()} trend.")
    st = g.alloc["stock"]; cash = 100 - sum(g.alloc.values())
    if st >= 60: out.append(f"Your portfolio is heavily concentrated in stocks ({st}%), increasing its exposure to market declines.")
    elif cash > 50: out.append(f"Over half your portfolio ({cash}%) is in cash. It limits losses in a decline but may lag in a recovery.")
    elif st == 0: out.append("You hold no stocks, so you would miss stock-market rallies but avoid stock-market declines.")
    else: out.append(f"Your portfolio is spread across assets (stocks {st}%, cash {cash}%), which can reduce reliance on any single market.")
    return out

