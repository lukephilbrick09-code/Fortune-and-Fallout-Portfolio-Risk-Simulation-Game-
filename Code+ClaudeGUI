def choose_next_phase(phase, age):
    """Pick the next market phase. Long bull runs raise (never force) the chance of a correction."""
    opts = dict(TRANSITIONS[phase])
    if phase == "Bull Market" and age >= CFG["OVEREXTEND_YEARS"]:
        opts["Market Correction"] *= 1 + 0.5 * (age - CFG["OVEREXTEND_YEARS"] + 1)
    return random.choices(list(opts), weights=list(opts.values()), k=1)[0]

def trend_adjustments(phase, last_market_return, drawdown):
    """Extra expected return for each asset (same order as NAMES). Applied once per year, before generate_return."""
    t = PHASE_TREND[phase]
    if phase in ("Bull Market", "Recovery"):  # momentum: gains make further gains more likely
        t += CFG["MOMENTUM"] * max(-0.1, min(0.25, last_market_return))
    if phase == "Recovery":  # rebound from depressed prices
        t += CFG["RECOVERY_BOOST"] * drawdown
    return [t * BETA[0], t * BETA[1], t * BETA[2], t, -0.1 * t, -0.2 * t, 0.0, 0.5 * t]

class Game:
    def __init__(s): s.reset()
    def reset(s):
        s.start = random.randint(80000, 120000); s.pf = s.start; s.year = 0
        mk = lambda n, t, st, bo, go, re, c: dict(name=n, tag=t, pf=100000.0, col=c,
              al=dict(stock=st, bond=bo, gold=go, re=re, cash=100 - st - bo - go - re))
        s.comps = [mk("The Guardian", "CONSERVATIVE", 15, 35, 20, 10, (0, 255, 240)),
                   mk("The Strategist", "BALANCED", 40, 25, 10, 15, (255, 230, 0)),
                   mk("The Maverick", "AGGRESSIVE", 75, 5, 5, 10, (255, 40, 200))]
        s.alloc = dict(stock=40, bond=20, gold=10, re=10); s.sub = [50, 30, 20]
        s.last = None; s.last_gain = None; s.last_ret = None; s.last_rets = None
        s.summary = []; s.result = None
        # NEW (Upgrade 1-2): market state, reset for every new game
        s.phase_name = None; s.phase_age = 0; s.phase_left = 0; s.phase_changed = False
        s.prices = dict(START_PRICES); s.index = 100.0
        s.peak = 100.0; s.drawdown = 0.0; s.dip = False; s.recovering = False; s.since_dip = 99
        # NEW (Upgrade 3): history lists used by the monitors and charts (index 0 = starting values)
        s.price_hist = {c: [START_PRICES[c]] for c in STOCKS}
        s.index_hist = [100.0]; s.phase_hist = []; s.event_hist = []; s.ret_hist = []
        s.pf_hist = {"You": [float(s.start)]}
        for c in s.comps: s.pf_hist[c["name"]] = [100000.0]
        s.begin_year()
    # NEW (Upgrade 1): persistent market phase
    def update_market_phase(s):
        s.phase_changed = False
        if s.phase_name is None:
            s.phase_name = random.choices(PHASES, weights=[PHASE_START[p] for p in PHASES], k=1)[0]
            s.phase_age = 1; s.phase_left = random.randint(*PHASE_LEN[s.phase_name]) - 1; s.phase_changed = True
            return
        s.phase_age += 1; s.phase_left -= 1
        if s.phase_left < 0 or (s.phase_age >= 2 and random.random() < CFG["EARLY_EXIT"]):
            s.phase_name = choose_next_phase(s.phase_name, s.phase_age)
            s.phase_age = 1; s.phase_left = random.randint(*PHASE_LEN[s.phase_name]) - 1; s.phase_changed = True
    def begin_year(s):
        s.year += 1; s.prev = s.pf
        s.update_market_phase()                                   # long-term trend (persistent)
        s.event = random.choices(EV_KEYS, weights=(15, 5, 10, 20, 50), k=1)[0]  # yearly event (separate)
        last_mkt = s.last_rets[3] if s.last_rets else 0.0
        s.trend_adj = trend_adjustments(s.phase_name, last_mkt, s.drawdown)
        s.means = [adjust_expected(m + a, adj) for m, a, adj in zip(EV[s.event]["means"], s.trend_adj, ADJ)]
        s.vols = [v * PHASE_VOL[s.phase_name] if i < 4 else v for i, v in enumerate(VOL)]
        s.rets = [generate_return(m, v) for m, v in zip(s.means, s.vols)]  # hidden until the year is confirmed
        s.phase = "event"; s.phase_t = now()
    def confirm(s, keep=False):
        if keep and s.last: s.alloc = dict(s.last[0]); s.sub = list(s.last[1])
        a, p = s.alloc, s.prev
        cash = 100 - sum(a.values())
        st = [p * a["stock"] / 100 * s.sub[i] / 100 * (1 + s.rets[i]) for i in range(3)]
        bond = p * a["bond"] / 100 * (1 + s.rets[4]); gold = p * a["gold"] / 100 * (1 + s.rets[5])
        cashv = p * cash / 100 * (1 + s.rets[6]); re = p * a["re"] / 100 * (1 + s.rets[7])
        s.result = [("BHRD", st[0], s.rets[0]), ("BPOP", st[1], s.rets[1]), ("MDTA", st[2], s.rets[2]),
                    ("Total stocks", sum(st), s.rets[3]), ("Bonds", bond, s.rets[4]), ("Gold", gold, s.rets[5]),
                    ("Cash", cashv, s.rets[6]), ("Real estate", re, s.rets[7])]
        s.pf = sum([sum(st), bond, gold, cashv, re])
        s.last_gain = s.pf - p; s.last_ret = s.last_gain / p * 100
        s.summary.append([s.year, s.event, p, s.last_gain, s.last_ret, s.pf])
        s.last = (dict(a), list(s.sub))
        s.record_year(); s.phase = "result"
    # NEW (Upgrade 3): update prices, competitors and history once the year is confirmed
    def record_year(s):
        for i, c in enumerate(STOCKS):                       # price falls/rises by exactly the stock's return
            s.prices[c] *= 1 + s.rets[i]; s.price_hist[c].append(s.prices[c])
        s.index *= 1 + s.rets[3]; s.index_hist.append(s.index)
        s.phase_hist.append(s.phase_name); s.event_hist.append(s.event)
        s.ret_hist.append([s.rets[3], s.rets[4], s.rets[5], s.rets[6], s.rets[7]])
        s.last_rets = list(s.rets)
        r = dict(stock=s.rets[3], bond=s.rets[4], gold=s.rets[5], cash=s.rets[6], re=s.rets[7])
        for c in s.comps:                                      # competitors use the SAME returns as the player
            c["prev"] = c["pf"]; c["pf"] = sum(c["prev"] * c["al"][k] / 100 * (1 + r[k]) for k in r)
            s.pf_hist[c["name"]].append(c["pf"])
        s.pf_hist["You"].append(s.pf)
        s.update_market_signals()
    # NEW (Upgrade 2): dip / recovery detection from the market index
    def update_market_signals(s):
        window = s.index_hist[-CFG["PEAK_WINDOW"]:]
        s.peak = max(window); s.drawdown = max(0.0, (s.peak - s.index) / s.peak)
        s.dip = s.drawdown >= CFG["DIP_THRESHOLD"]
        s.since_dip = 0 if s.dip else s.since_dip + 1
        s.recovering = s.rets[3] > 0 and s.drawdown > 0.03 and s.since_dip <= 2
    def advance(s):
        if s.year >= YEARS:
            s.board = sorted([("You", s.pf, s.start)] + [(c["name"], c["pf"], 100000) for c in s.comps],
                             key=lambda r: r[1], reverse=True)
            s.phase = "final"
        else: s.begin_year()

