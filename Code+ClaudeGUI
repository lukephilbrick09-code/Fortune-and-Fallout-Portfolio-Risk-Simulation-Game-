def nice_scale(lo, hi, n=5):
    span = max(hi - lo, 1e-9); raw = span / n; mag = 10 ** math.floor(math.log10(raw))
    step = next(m * mag for m in (1, 2, 2.5, 5, 10) if m * mag >= raw)
    return math.floor(lo / step) * step, math.ceil(hi / step) * step, step
def legend(items, x, y):
    for lab, col in items:
        pygame.draw.rect(screen, col, (x, y + 3, 12, 10)); text(screen, lab, f_s, PGREEN, (x + 17, y)); x += 17 + f_s.size(lab)[0] + 16
def chart_frame(r, title, ylabel, lo, hi, step, yfmt, groups=False):
    box(r); text(screen, title, f_mb, AMBER, (r.x + 12, r.y + 8)); text(screen, ylabel, f_s, CYAN, (r.x + 12, r.y + 34))
    pr = pygame.Rect(r.x + 74, r.y + 58, r.w - 94, r.h - 58 - 44)
    v = lo
    while v <= hi + 1e-9:
        y = pr.bottom - (v - lo) / (hi - lo) * pr.h
        pygame.draw.line(screen, (36, 28, 10), (pr.x, y), (pr.right, y)); text(screen, yfmt(v), f_s, PGREEN, (pr.x - 6, y), "midright"); v += step
    for i in range(YEARS + 1):
        x = pr.x + i / YEARS * pr.w; pygame.draw.line(screen, (24, 18, 8), (x, pr.y), (x, pr.bottom))
        if groups and i < YEARS: text(screen, f"Y{i + 1}", f_s, PGREEN, (x + pr.w / YEARS / 2, pr.bottom + 6), "midtop")
        elif not groups: text(screen, f"Y{i}", f_s, PGREEN, (x, pr.bottom + 6), "midtop")
    text(screen, "YEAR", f_s, CYAN, (pr.centerx, pr.bottom + 26), "midtop")
    pygame.draw.rect(screen, LINE, pr, 1)
    return pr
def pts_of(pr, vals, lo, hi): return [(pr.x + i / YEARS * pr.w, pr.bottom - (v - lo) / (hi - lo) * pr.h) for i, v in enumerate(vals)]
def draw_series(pts, col):
