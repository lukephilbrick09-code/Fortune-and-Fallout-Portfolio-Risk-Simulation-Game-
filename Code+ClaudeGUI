def tri(surf, x, y, up, col, sz=4):
    pts = [(x, y - sz), (x - sz, y + sz), (x + sz, y + sz)] if up else [(x, y + sz), (x - sz, y - sz), (x + sz, y - sz)]
    pygame.draw.polygon(surf, col, pts)

