def chart_d(r):  # grouped bars of annual asset returns
    rows = g.ret_hist; vals = [x for row in rows for x in row] + [0]
    lo, hi, step = nice_scale(min(vals) - 0.02, max(vals) + 0.02)
    pr = chart_frame(r, "D  ANNUAL ASSET RETURNS", "RETURN (%)", lo, hi, step, lambda x: f"{x * 100:.0f}%", groups=True)
    legend(list(zip(["STOCKS", "BONDS", "GOLD", "CASH", "REAL ESTATE"], ASSET_COL)), r.x + 150, r.y + 34)
    y0 = pr.bottom - (0 - lo) / (hi - lo) * pr.h; gw = pr.w / YEARS; bw = gw * 0.8 / 5
    for j, row in enumerate(rows):
        for k, v in enumerate(row):
            y = pr.bottom - (v - lo) / (hi - lo) * pr.h
            pygame.draw.rect(screen, ASSET_COL[k], (int(pr.x + j * gw + gw * 0.1 + k * bw), int(min(y, y0)), max(1, int(bw) - 1), max(1, int(abs(y - y0)))))
    pygame.draw.line(screen, (255, 255, 255), (pr.x, y0), (pr.right, y0), 2)
    if not rows: text(screen, "No completed years yet", f_m, (120, 120, 120), pr.center, "center")

